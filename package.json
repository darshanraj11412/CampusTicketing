{
  "name": "campus-event-ticketing",
  "version": "2.0.0",
  "description": "Full-stack campus event ticketing platform with real-time seat locking, QR check-in & organizer dashboard - RV University CS3301",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev:server": "nodemon server/server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client",
    "test": "node --test --test-concurrency=1",
    "seed": "node server/seed.js"
  },
  "keywords": [
    "campus",
    "event-ticketing",
    "real-time",
    "websockets",
    "jwt",
    "mern",
    "rv-university"
  ],
  "author": "Team 8 (Arjun N, Darshan R, Dakshith Saraf)",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9"
  }
}
